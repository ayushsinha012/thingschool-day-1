<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>19a1a19b-f157-49ec-a09a-c0e1a11a0b45</UserSecretsId>

    <!-- ContainerImageName is the obsolete alias for ContainerRepository (SDK
         warning CONTAINER003) and, per Microsoft.NET.Build.Containers.targets,
         unconditionally overwrites ContainerRepository even when azd supplies
         it via -p:ContainerRepository on the command line - causing azd's
         `dotnet publish -p:ContainerRepository=<service>/<service>-<env>`
         convention to be silently ignored, so the pushed image landed at a
         different repository path than the one the Container App revision
         was configured to pull (ImagePullBackOff). Removed so ContainerRepository
         resolves normally: azd's command-line value when it supplies one,
         otherwise the SDK's own AssemblyName-based default. -->
    <ContainerImageTag>0.1.0</ContainerImageTag>
    <!-- Base image is glibc (Debian). This was previously the musl/Alpine
         variant (mcr.microsoft.com/dotnet/aspnet:10.0-alpine) with
         ContainerRuntimeIdentifier=linux-musl-x64, on the assumption that
         ContainerRuntimeIdentifier also controlled which RID-specific native
         assets (e.g. SQLitePCLRaw's e_sqlite3) get published. It does not:
         that is governed solely by RuntimeIdentifier. azd's own `dotnet
         publish` invocation for this containerapp/dotnet service
         unconditionally passes `-r linux-x64` on the command line (confirmed -
         it does not read ContainerRuntimeIdentifier, and a command-line -r
         always wins over any RuntimeIdentifier set in the project), so the
         published image always contained the glibc build of e_sqlite3
         regardless of the musl base image - crashing at startup with
         DllNotFoundException: Unable to load shared library 'e_sqlite3',
         confirmed via actual deployed container console logs
         (CrashLoopBackOff). Matching the base image to glibc/linux-x64 -
         what azd actually publishes - resolves the mismatch instead of
         fighting it. RuntimeIdentifier itself is intentionally left unset
         here (rather than pinned to linux-x64) precisely because azd's
         publish already supplies it explicitly on the command line every
         time: pinning it in the project only ever affected commands that
         don't pass -r, i.e. local `dotnet build`/`dotnet run`, which then
         produced a linux-x64 apphost that cannot execute on a Windows dev
         machine. Left unset, local builds are portable/framework-dependent
         and each PackageReference's RID-specific native assets (e_sqlite3
         included) resolve against the host OS at run time, so `dotnet run`
         works natively on Windows while azd's container publish is unaffected. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />

    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />

    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />

    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />

    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests.Domain, Tests.Integration and Migrations.SqlServer are separate
         projects nested under this one on disk. Excluding their *.cs files
         from Compile isn't enough on its own: once any of them is built, its
         own bin/obj sits inside this project's folder tree too, and the SDK's
         default Content/None globs pick it up as this project's own output.
         The next build of QuotesApi then copies that nested bin/obj into its
         own output directory - which, being inside the same tree, is globbed
         and copied again one level deeper on each subsequent build
         (cascading MSB3030 "could not copy file" errors). Excluding each
         nested project's whole folder from Compile/Content/None stops this
         project's globs from ever seeing their bin/obj at all. -->
    <Compile Remove="Tests.Domain/**/*.cs" />
    <Compile Remove="Tests.Integration/**/*.cs" />
    <Compile Remove="Migrations.SqlServer/**/*.cs" />
    <Content Remove="Tests.Domain/**" />
    <Content Remove="Tests.Integration/**" />
    <Content Remove="Migrations.SqlServer/**" />
    <None Remove="Tests.Domain/**" />
    <None Remove="Tests.Integration/**" />
    <None Remove="Migrations.SqlServer/**" />
  </ItemGroup>

</Project>
