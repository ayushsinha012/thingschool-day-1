{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({TraceId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AuthSecurity": {
    "IdleTimeoutMinutes": 20,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RateLimitPermitsPerWindow": 10,
    "RateLimitWindowSeconds": 60
  },
  "Entra": {
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "sb-quotesapi-thinkschool.servicebus.windows.net",
    "TopicName": "quote-events",
    "SubscriptionA": "sub-day26-audit",
    "SubscriptionB": "sub-day26-notifications",
    "MaxConcurrentCallsPerSubscription": 2
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "CloudRoleName": "quotes-api-day26"
  },
  "AllowedHosts": "*"
}
